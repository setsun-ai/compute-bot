[Unit]
Description=compute-bot: runner zadań (jedno naraz, najniższy priorytet)
After=network-online.target

[Service]
User=compute
Group=compute
# No token here: jobs are the owner's scripts and never need it.
EnvironmentFile=/etc/compute-runner.env
Environment=COMPUTE_HOME=/var/lib/compute-bot
Environment=COMPUTE_PYTHON=/var/lib/compute-bot/env/bin/python
Environment=MAMBA_ROOT_PREFIX=/var/lib/compute-bot/mamba
Environment=PATH=/opt/compute-bot/bin:/usr/local/bin:/usr/bin:/bin
ExecStart=/usr/bin/python3 /opt/compute-bot/app/launch.py runner
Restart=always
RestartSec=15
# Group compute (the owner's login too) shares the jobs: see deploy/remote.sh.
UMask=0007

# Game servers and the other bots on this laptop always come first.
Nice=19
CPUSchedulingPolicy=batch
IOSchedulingClass=idle
# The laptop has 8 GB: jobs get 6, so the system, the bots and an AMP server always keep 2. Above 5 GB the
# kernel reclaims the job's memory first; at 6 GB the job (not the laptop) is killed.
MemoryHigh=5G
MemoryMax=6G
MemorySwapMax=2G
# A stopped runner takes its job with it; on start it runs it again (md_step resumes from the checkpoint).
KillMode=control-group
TimeoutStopSec=30

NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ProtectHome=yes
ReadWritePaths=/var/lib/compute-bot

[Install]
WantedBy=multi-user.target
